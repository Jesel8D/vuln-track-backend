# Public metadata only. Never put credentials here. Generate runtime separately.
COMPOSE_PROJECT_NAME=vulntrack-production
RUNTIME_DIR=/srv/vulntrack-private-runtime
PUBLIC_ORIGIN=https://vulntrack.example.org
SITE_HOST=vulntrack.example.org
ACME_EMAIL=operator@example.org
# Safe default for the laptop. In EC2 change only after server/SG verification.
PUBLIC_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
# ACME: empty. Local validation only: internal (untrusted by public browsers).
TLS_MODE=
