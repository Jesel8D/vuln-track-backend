  "constraints": [
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_asset_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (asset_id) REFERENCES vulntrack.assets(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_coverage_valid",
      "type": "c",
      "definition": "CHECK ((coverage = ANY (ARRAY['complete'::text, 'partial'::text])))"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_cpe_valid",
      "type": "c",
      "definition": "CHECK (((\"left\"(selected_cpe, 8) = 'cpe:2.3:'::text) AND vulntrack.valid_text(selected_cpe, 1024)))"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_execution_order",
      "type": "c",
      "definition": "CHECK ((completed_at >= started_at))"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_initiated_by_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (initiated_by) REFERENCES vulntrack.users(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_kind_v1",
      "type": "c",
      "definition": "CHECK ((kind = 'nvd_cve'::text))"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_lifecycle",
      "type": "c",
      "definition": "CHECK ((((status = 'queued'::text) AND (started_at IS NULL) AND (completed_at IS NULL) AND (coverage IS NULL)) OR ((status = 'running'::text) AND (started_at IS NOT NULL) AND (completed_at IS NULL) AND (coverage IS NULL)) OR ((status = 'completed'::text) AND (started_at IS NOT NULL) AND (completed_at IS NOT NULL) AND (coverage IS NOT NULL)) OR ((status = 'failed'::text) AND (completed_at IS NOT NULL))))"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_status_valid",
      "type": "c",
      "definition": "CHECK ((status = ANY (ARRAY['queued'::text, 'running'::text, 'completed'::text, 'failed'::text])))"
    },
    {
      "table_name": "analysis_runs",
      "name": "analysis_runs_time_order",
      "type": "c",
      "definition": "CHECK ((updated_at >= created_at))"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "asset_registration_requests_asset_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (asset_id) REFERENCES vulntrack.assets(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "asset_registration_requests_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (user_id, method, route, idempotency_key)"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "asset_registration_requests_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES vulntrack.users(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "registration_expiry",
      "type": "c",
      "definition": "CHECK ((expires_at > created_at))"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "registration_hash_valid",
      "type": "c",
      "definition": "CHECK ((request_hash ~ '^[0-9a-f]{64}$'::text))"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "registration_response_status",
      "type": "c",
      "definition": "CHECK ((response_status = 201))"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "registration_response_valid",
      "type": "c",
      "definition": "CHECK (((jsonb_typeof(response_body) = 'object'::text) AND (response_body ? 'id'::text) AND ((response_body ->> 'id'::text) IS NOT NULL) AND ((response_body ->> 'id'::text) = (asset_id)::text)))"
    },
    {
      "table_name": "asset_registration_requests",
      "name": "registration_scope",
      "type": "c",
      "definition": "CHECK (((method = 'POST'::text) AND (route = '/assets'::text)))"
    },
    {
      "table_name": "assets",
      "name": "assets_device_type_valid",
      "type": "c",
      "definition": "CHECK (vulntrack.valid_text(device_type, 80))"
    },
    {
      "table_name": "assets",
      "name": "assets_inventory_label_valid",
      "type": "c",
      "definition": "CHECK (((inventory_label IS NULL) OR vulntrack.valid_text(inventory_label, 120)))"
    },
    {
      "table_name": "assets",
      "name": "assets_manufacturer_valid",
      "type": "c",
      "definition": "CHECK (vulntrack.valid_text(manufacturer, 120))"
    },
    {
      "table_name": "assets",
      "name": "assets_model_valid",
      "type": "c",
      "definition": "CHECK (vulntrack.valid_text(model, 120))"
    },
    {
      "table_name": "assets",
      "name": "assets_notes_valid",
      "type": "c",
      "definition": "CHECK (((notes IS NULL) OR vulntrack.valid_text(notes, 1000)))"
    },
    {
      "table_name": "assets",
      "name": "assets_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "assets",
      "name": "assets_site_label_valid",
      "type": "c",
      "definition": "CHECK (vulntrack.valid_text(site_label, 120))"
    },
    {
      "table_name": "assets",
      "name": "assets_time_order",
      "type": "c",
      "definition": "CHECK ((updated_at >= created_at))"
    },
    {
      "table_name": "assets",
      "name": "assets_version_valid",
      "type": "c",
      "definition": "CHECK (vulntrack.valid_text(version, 120))"
    },
    {
      "table_name": "findings",
      "name": "findings_analysis_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (analysis_id) REFERENCES vulntrack.analysis_runs(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "findings",
      "name": "findings_applicability_v1",
      "type": "c",
      "definition": "CHECK ((applicability = 'potential'::text))"
    },
    {
      "table_name": "findings",
      "name": "findings_cve_valid",
      "type": "c",
      "definition": "CHECK ((external_id ~ '^CVE-[0-9]{4}-[0-9]{4,}$'::text))"
    },
    {
      "table_name": "findings",
      "name": "findings_cvss_object",
      "type": "c",
      "definition": "CHECK (((cvss IS NULL) OR (jsonb_typeof(cvss) = 'object'::text)))"
    },
    {
      "table_name": "findings",
      "name": "findings_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "findings",
      "name": "findings_source_v1",
      "type": "c",
      "definition": "CHECK ((source = 'NVD'::text))"
    },
    {
      "table_name": "findings",
      "name": "findings_status_valid",
      "type": "c",
      "definition": "CHECK ((status = ANY (ARRAY['open'::text, 'reviewed'::text])))"
    },
    {
      "table_name": "findings",
      "name": "findings_time_order",
      "type": "c",
      "definition": "CHECK ((updated_at >= created_at))"
    },
    {
      "table_name": "findings",
      "name": "findings_title_valid",
      "type": "c",
      "definition": "CHECK (((title IS NULL) OR vulntrack.valid_text(title, 500)))"
    },
    {
      "table_name": "users",
      "name": "users_hash_not_plaintext",
      "type": "c",
      "definition": "CHECK (((password_hash IS NULL) OR (password_hash ~ '^\\$argon2id\\$v=19\\$m=[0-9]+,t=[0-9]+,p=[0-9]+\\$[A-Za-z0-9+/]+\\$[A-Za-z0-9+/]+$'::text)))"
    },
    {
      "table_name": "users",
      "name": "users_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "users",
      "name": "users_time_order",
      "type": "c",
      "definition": "CHECK ((updated_at >= created_at))"
    },
    {
      "table_name": "users",
      "name": "users_username_key",
      "type": "u",
      "definition": "UNIQUE (username)"
    },
    {
      "table_name": "users",
      "name": "users_username_valid",
      "type": "c",
      "definition": "CHECK ((username ~ '^[a-z0-9][a-z0-9_.-]{0,79}$'::text))"
    }
  ],
