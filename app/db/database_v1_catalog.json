  "functions": [
    {
      "name": "touch_updated_at",
      "definition": "CREATE OR REPLACE FUNCTION vulntrack.touch_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    IF NEW.id IS DISTINCT FROM OLD.id OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN\n        RAISE EXCEPTION 'id y created_at son inmutables' USING ERRCODE = '23514';\n    END IF;\n    NEW.updated_at := greatest(clock_timestamp(), OLD.updated_at);\n    RETURN NEW;\nEND $function$\n"
    },
    {
      "name": "valid_text",
      "definition": "CREATE OR REPLACE FUNCTION vulntrack.valid_text(value text, maximum integer)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$ SELECT char_length(value) BETWEEN 1 AND maximum\n       AND value !~ '^[[:space:]]|[[:space:]]$' $function$\n"
    }
  ],
