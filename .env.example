# Copiar a .env (ignorado). Completar con secretos generados fuera de Git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://vulntrack_api:REPLACE_PASSWORD@127.0.0.1:55432/vulntrack
TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET
TOKEN_TTL_SECONDS=900
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
MAX_BODY_BYTES=8192
LOGIN_ATTEMPTS_PER_MINUTE=10
# Producción: DATABASE_URL debe incluir sslmode=verify-full&sslrootcert=/ruta/ca.pem
# JSON de orígenes explícitos. Vacío mantiene acceso cross-origin del navegador deshabilitado.
CORS_ORIGINS=[]
# Desarrollo Vite, elegir SOLO los orígenes que realmente se utilicen:
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Producción, ejemplo no habilitado: CORS_ORIGINS=["https://portal.example.edu"]
# Bearer explícito; cookies cross-origin no soportadas. true se rechaza.
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# NVD: opcional, solo backend. Nunca subir una key real; una instancia/worker API.
# NVD_API_KEY=
NVD_TIMEOUT_SECONDS=10
