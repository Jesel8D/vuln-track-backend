# Copiar a .env (ignorado). Completar con secretos generados fuera de Git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://vulntrack_api:REPLACE_PASSWORD@127.0.0.1:55432/vulntrack
TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET
TOKEN_TTL_SECONDS=900
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
MAX_BODY_BYTES=8192
LOGIN_ATTEMPTS_PER_MINUTE=10
# Producción: DATABASE_URL debe incluir sslmode=verify-full&sslrootcert=/ruta/ca.pem
