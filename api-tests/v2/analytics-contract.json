            "default": "UTC"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "days",
          "start",
          "end_exclusive",
          "observed_at"
        ],
        "title": "InventoryEventWindow"
      },
      "InventoryEvents": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Workspace Id"
          },
          "inventory_kind": {
            "type": "string",
            "enum": [
              "devices",
              "technologies"
            ],
            "title": "Inventory Kind"
          },
          "scope": {
            "type": "string",
            "const": "recorded_history",
            "title": "Scope",
            "default": "recorded_history"
          },
          "window": {
            "$ref": "#/components/schemas/InventoryEventWindow"
          },
          "totals": {
            "$ref": "#/components/schemas/InventoryEventCounts"
          },
          "confirmation_modes": {
            "$ref": "#/components/schemas/CatalogModes"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/InventoryEventDay"
            },
            "type": "array",
            "maxItems": 90,
            "minItems": 30,
            "title": "Daily"
          },
          "selections_without_confirmation_events": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Selections Without Confirmation Events"
          },
          "version_history_available": {
            "type": "boolean",
            "title": "Version History Available"
          }
        },
        "type": "object",
        "required": [
          "workspace_id",
          "inventory_kind",
          "window",
          "totals",
          "confirmation_modes",
          "daily",
          "selections_without_confirmation_events",
          "version_history_available"
        ],
        "title": "InventoryEvents"
      }
    }
