    "schemas": {
      "InventoryCategory": {
        "properties": {
          "vendor_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Vendor Key"
          },
          "product_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Key"
          },
          "label": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Label"
          },
          "count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "vendor_key",
          "label",
          "count"
        ],
        "title": "InventoryCategory"
      },
      "InventoryDistribution": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Workspace Id"
          },
          "inventory_kind": {
            "type": "string",
            "enum": [
              "devices",
              "technologies"
            ],
            "title": "Inventory Kind"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "vendor",
              "product"
            ],
            "title": "Dimension"
          },
          "scope": {
            "type": "string",
            "const": "active",
            "title": "Scope",
            "default": "active"
          },
          "normalization": {
            "type": "string",
            "const": "case_whitespace_v1",
            "title": "Normalization",
            "default": "case_whitespace_v1"
          },
          "limit": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "excluded_inactive": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Excluded Inactive"
          },
          "unknown": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unknown"
          },
          "other": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Other"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/InventoryCategory"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Categories"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "workspace_id",
          "inventory_kind",
          "dimension",
          "limit",
          "total",
          "excluded_inactive",
          "unknown",
          "other",
          "categories",
          "observed_at"
        ],
        "title": "InventoryDistribution"
      },
      "InventoryEventCounts": {
        "properties": {
          "first_confirmations": {
            "type": "integer",
            "minimum": 0.0,
            "title": "First Confirmations",
            "default": 0
          },
          "subsequent_confirmations": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Subsequent Confirmations",
            "default": 0
          },
          "technology_confirmations": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Technology Confirmations",
            "default": 0
          },
          "version_changes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version Changes",
            "default": 0
          },
          "identity_changes_without_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Identity Changes Without Version",
            "default": 0
          }
        },
        "type": "object",
        "title": "InventoryEventCounts"
      },
      "InventoryEventDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "counts": {
            "$ref": "#/components/schemas/InventoryEventCounts"
          }
        },
        "type": "object",
        "required": [
          "date",
          "counts"
