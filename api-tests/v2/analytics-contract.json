            "required": false,
            "schema": {
              "enum": [
                "devices",
                "technologies"
              ],
              "type": "string",
              "default": "devices",
              "title": "Inventory Kind"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 90,
              "minimum": 30,
              "description": "Ventana diaria UTC: \u00fanicamente 30 o 90 d\u00edas.",
