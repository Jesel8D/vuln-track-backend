        "title": "InventoryEventDay"
      },
      "InventoryEventWindow": {
        "properties": {
          "days": {
            "type": "integer",
            "enum": [
              30,
              90
            ],
            "title": "Days"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end_exclusive": {
            "type": "string",
            "format": "date",
            "title": "End Exclusive"
          },
          "timezone": {
            "type": "string",
            "const": "UTC",
