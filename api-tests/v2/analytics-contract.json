  "additions": {
    "operations": {
      "GET /api/v2/workspaces/{workspace_id}/inventory-analytics/distribution": {
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          },
          {
            "name": "inventory_kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "devices",
                "technologies"
              ],
              "type": "string",
              "default": "devices",
              "title": "Inventory Kind"
            }
          },
          {
            "name": "dimension",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "vendor",
                "product"
              ],
              "type": "string",
              "default": "vendor",
              "title": "Dimension"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
