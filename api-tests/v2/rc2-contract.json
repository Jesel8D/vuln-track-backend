  "schemas": {
    "DeviceCreate": {
      "additionalProperties": false,
      "properties": {
        "component_kind": {
          "enum": [
            "firmware",
            "os",
            "software",
            "hardware"
          ],
          "title": "Component Kind",
          "type": "string"
        },
        "device_type": {
          "enum": [
            "router",
            "switch",
            "server"
          ],
          "title": "Device Type",
          "type": "string"
        },
        "inventory_label": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inventory Label"
        },
        "manufacturer": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Manufacturer",
          "type": "string"
        },
        "model": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "product": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "product_vendor": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Product Vendor",
          "type": "string"
        },
        "site_label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Site Label",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "device_type",
        "manufacturer",
        "model",
        "product_vendor",
        "product",
        "component_kind",
        "site_label"
      ],
      "title": "DeviceCreate",
      "type": "object"
    },
    "DeviceFindingReview": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "potential",
            "undetermined",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "expected_updated_at": {
          "format": "date-time",
          "title": "Expected Updated At",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "applicability",
        "expected_updated_at",
        "reason",
        "evidence"
      ],
      "title": "DeviceFindingReview",
      "type": "object"
    },
    "DeviceIdentificationCreate": {
      "additionalProperties": false,
      "properties": {
        "cpe_name_id": {
          "format": "uuid",
          "title": "Cpe Name Id",
          "type": "string"
        },
        "expected_identification_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Identification Id"
        },
        "reason": {
