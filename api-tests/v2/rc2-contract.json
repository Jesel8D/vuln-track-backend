          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "recommendation"
      ],
      "title": "DeviceRecommendationCreate",
      "type": "object"
    },
    "DeviceStatusUpdate": {
      "additionalProperties": false,
