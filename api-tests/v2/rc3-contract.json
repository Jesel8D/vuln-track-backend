        "expected_record_version": {
          "type": "integer",
          "maximum": 9007199254740991.0,
          "minimum": 1.0,
          "title": "Expected Record Version"
        },
        "reason": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason"
        },
        "confirm_sensitive": {
          "type": "boolean",
          "title": "Confirm Sensitive",
          "default": false
        },
        "device_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "router",
                "switch",
                "server"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Type"
        },
        "manufacturer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Manufacturer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "site_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Site Label"
        },
        "inventory_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
