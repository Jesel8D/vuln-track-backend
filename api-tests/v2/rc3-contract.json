        },
        "confirmed": {
          "type": "boolean",
          "const": true,
          "title": "Confirmed"
        },
        "reason": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason"
        },
        "expected_record_version": {
          "type": "integer",
          "maximum": 9007199254740991.0,
          "minimum": 1.0,
          "title": "Expected Record Version"
        },
        "expected_identification_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
