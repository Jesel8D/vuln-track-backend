        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "active",
                "retired"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "component_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "firmware",
                "os",
                "software",
                "hardware"
              ]
            },
