      "additionalProperties": false,
      "type": "object",
      "required": [
        "cpe_name_id",
        "expected_cpe_name",
        "expected_nvd_modified",
        "mode",
        "confirmed",
        "reason",
        "expected_record_version",
        "expected_identification_id"
      ],
      "title": "DeviceReidentification"
