  "schemas": {
    "CatalogSelection": {
      "properties": {
        "cpe_name_id": {
          "type": "string",
          "format": "uuid",
          "title": "Cpe Name Id"
        },
        "expected_cpe_name": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 8,
          "title": "Expected Cpe Name"
        },
        "expected_nvd_modified": {
          "type": "string",
          "format": "date-time",
          "title": "Expected Nvd Modified"
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixture",
            "live"
          ],
          "title": "Mode"
        },
        "confirmed": {
          "type": "boolean",
          "const": true,
          "title": "Confirmed"
        },
        "reason": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "cpe_name_id",
        "expected_cpe_name",
        "expected_nvd_modified",
        "mode",
        "confirmed",
        "reason"
      ],
      "title": "CatalogSelection"
    },
    "DeviceCreate": {
      "properties": {
        "device_type": {
          "type": "string",
          "enum": [
            "router",
            "switch",
            "server"
          ],
          "title": "Device Type"
        },
        "manufacturer": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1,
          "title": "Manufacturer"
        },
        "model": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1,
          "title": "Model"
        },
        "product_vendor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Vendor"
        },
        "product": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Product"
        },
        "component_kind": {
          "type": "string",
          "enum": [
            "firmware",
            "os",
            "software",
            "hardware"
          ],
          "title": "Component Kind"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        },
        "site_label": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1,
          "title": "Site Label"
        },
        "inventory_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Inventory Label"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "catalog_selection": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/CatalogSelection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "device_type",
        "manufacturer",
        "model",
        "component_kind",
        "site_label"
      ],
      "title": "DeviceCreate"
    }
