# Reference only: scripts.v2_development generates a PRIVATE per-installation .env.
# Never reuse another project's volume, container or secrets.
VT_PROJECT=vulntrack-v2-development
VT_CONTAINER=vulntrack-v2-development-postgres
VT_VOLUME=vulntrack_v2_development_pgdata
VT_PG_PORT=55434
VT_INSTALLATION=
VT_PASSWORD_FILE=
# Passwords, JWT and HMAC are generated locally, never placed in this example.
